# LLM + MCP (shared with ReAct/)
GEMINI_API_KEY=
# Reviewer (ReAct) + Fixer — larger model. Use 2.5 Flash or newer Flash model.
GEMINI_MODEL=gemini-2.5-flash

# Init + Pusher — small / cheap models (SLM tier)
GEMINI_MODEL_INIT=gemini-2.5-flash-lite
GEMINI_MODEL_PUSHER=gemini-2.5-flash-lite
# Set false to skip SLM calls (init uses MCP only; pusher uses template)
ORCH_USE_SLM=true

# MCP (default: self-hosted github-mcp-server on localhost; uses GITHUB_TOKEN as Bearer)
MCP_SERVER_URL=http://localhost:8000
GITHUB_TOKEN=

# A2A local agent servers
A2A_HOST=127.0.0.1
A2A_INIT_PORT=9101
A2A_REVIEWER_PORT=9102
A2A_FIXER_PORT=9103
A2A_TESTER_PORT=9104
A2A_PUSHER_PORT=9105

# A2A orchestrator discovery URLs
A2A_INIT_URL=http://127.0.0.1:9101
A2A_REVIEWER_URL=http://127.0.0.1:9102
A2A_FIXER_URL=http://127.0.0.1:9103
A2A_TESTER_URL=http://127.0.0.1:9104
A2A_PUSHER_URL=http://127.0.0.1:9105

# Orchestration knobs
ORCH_MAX_ITERATIONS=5
# Comma-separated severities the fixer will attempt to address.
ORCH_FIX_SEVERITIES=blocking,major

# Tester (CI poll) settings
ORCH_TESTER_TIMEOUT=600

# A2A JSON checkpoints (resume-on-crash)
A2A_CHECKPOINT_DIR=.a2a_checkpoints
