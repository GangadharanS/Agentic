# ============================================================================
# Orchestration_ADK — Google ADK PR orchestrator
# GCP Gemini models + remote GitHub MCP server (Option C)
# ============================================================================

# ---- GCP Gemini models -----------------------------------------------------
# Choose ONE auth path:
#
# (1) Vertex AI (true GCP). Run `gcloud auth application-default login` first.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
#
# (2) Google AI Studio API key (simplest; used when Vertex is FALSE).
#     Get a free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# The Reviewer reuses ReAct/PRReviewAgent, which reads GEMINI_API_KEY:
GEMINI_API_KEY=

# Models (Gemini on Vertex AI or AI Studio)
ADK_REVIEWER_MODEL=gemini-2.0-flash      # informational; reviewer uses GEMINI_MODEL via ReAct
GEMINI_MODEL=gemini-2.0-flash            # Reviewer (ReAct) + Fixer
GEMINI_MODEL_INIT=gemini-2.5-flash-lite  # Init brief (SLM tier)
GEMINI_MODEL_PUSHER=gemini-2.5-flash-lite # Pusher summary (SLM tier)
ORCH_USE_SLM=true

# ---- Remote GitHub MCP (Option C) ------------------------------------------
# GitHub-hosted remote MCP. The client sends GITHUB_TOKEN as a Bearer header.
MCP_SERVER_URL=https://api.githubcopilot.com/mcp/
MCP_TRANSPORT=streamable
GITHUB_TOKEN=

# ---- Orchestration knobs ---------------------------------------------------
ORCH_MAX_ITERATIONS=5
ORCH_FIX_SEVERITIES=blocking,major
ORCH_TESTER_TIMEOUT=600
